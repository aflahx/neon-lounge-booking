{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "neon-nights-gateway",
      "version": "0.1.0",
      "title": "Neon Nights Gateway"
    },
    "tools": [
      {
        "name": "get_cafe_info",
        "title": "Get cafe info",
        "description": "Get Blackout Gaming Cafe's location, opening hours, phone, WhatsApp and Instagram details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_pricing",
        "title": "Get pricing",
        "description": "Get the current hourly gaming rates for single, duo and squad sessions at Blackout Gaming Cafe.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_events",
        "title": "List events and offers",
        "description": "List the recurring event formats and offer types at Blackout Gaming Cafe (game nights, tournaments, group events, seasonal offers).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "build_booking_request",
        "title": "Build booking request",
        "description": "Build a ready-to-send WhatsApp booking request link for a gaming session. Bookings are only confirmed once the cafe replies on WhatsApp — this tool does not reserve a slot.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "players": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "description": "Number of players (1, 2 or 4)."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Session date."
            },
            "time": {
              "type": "string",
              "minLength": 1,
              "description": "Preferred start time, e.g. '07:00 PM'."
            }
          },
          "required": [
            "players",
            "date",
            "time"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
